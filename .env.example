# Copy to .env for local development; never prefix server credentials with VITE_.
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
HOST=127.0.0.1
# Local development stores data in ./data/store.db when TURSO_DATABASE_URL is empty.
DATA_DIR=./data

# Production database (free Turso database). Required when NODE_ENV=production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Comma-separated owner wallet addresses permitted to upload/publish.
# Sign-in proves wallet ownership; knowing an address is not authentication.
ADMIN_WALLETS=

# Payments fail closed until all of these are deliberately configured.
PAYMENTS_ENABLED=false
# This implementation supports native USDC on Base (8453).
CHAIN_ID=8453
PAYOUT_WALLET=
RPC_URL=https://mainnet.base.org
CONFIRMATIONS=12

# Public customer support contact. Required to enable payments.
SUPPORT_EMAIL=
